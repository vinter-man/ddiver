# my.telegram.org → API development tools
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# @BotFather → /newbot (do NOT add this bot to the monitored chats; it only writes to you)
BOT_TOKEN=123456789:AA...

# Your Telegram user id (@userinfobot). `ddiver login` prints it too.
OWNER_ID=100200300

# Optional
DATA_DIR=data
LOG_LEVEL=INFO
LOG_FORMAT=text            # json when a log shipper reads this

# Optional: watching it. See the README's "Watching it" section.
# METRICS_PORT=9109        # 0 (the default) serves no /metrics at all
# METRICS_HOST=127.0.0.1   # 0.0.0.0 when a collector scrapes across a container network
# PING_URL=                # a dead-man's switch: healthchecks.io, Uptime Kuma push, ...
# PING_INTERVAL=60         # seconds; the heartbeat runs more often than any monitor needs
# ALERT_TELEGRAM_TOKEN=    # for Grafana's alerts. The same bot works; a second one keeps
# ALERT_TELEGRAM_CHAT_ID=  # alerting alive if you ever revoke the first token
# GRAFANA_USER=admin
# GRAFANA_PASSWORD=change-me
CATCHUP_HOURS=24
CATCHUP_MAX_PER_CHAT=500
DIGEST_THRESHOLD=20
REGEX_TIMEOUT_MS=20
IGNORE_OWN_MESSAGES=true
